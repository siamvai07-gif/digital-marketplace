{
  "rules": {
    ".read": false,
    ".write": false,

    "products": {
      ".read": true,
      "$productId": { ".write": "auth != null && auth.uid != null" }
    },

    "settings": {
      ".read": true,
      "$settingKey": { ".write": "auth != null && auth.uid != null" }
    },

    "reviews": {
      ".read": true,
      "$reviewId": {
        ".write": "auth != null && (!data.exists() || newData.child('uid').val() === auth.uid)",
        "rating": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
        "text":   { ".validate": "newData.isString() && newData.val().length <= 1000" }
      }
    },

    "lookup": {
      "email": { "$ident": { ".read": true, ".write": "auth != null" } },
      "phone": { "$ident": { ".read": true, ".write": "auth != null" } }
    },

    "customers": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && ($uid === auth.uid || root.child('customers').child(auth.uid).child('isAdmin').val() === true)",
        "passwordHash": { ".validate": "newData.isString()" },
        "walletCoins":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "status":       { ".validate": "newData.val() === 'ACTIVE' || newData.val() === 'SUSPENDED'" }
      }
    },

    "orders": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && (!data.exists() || data.child('userId').val() === auth.uid)",
        "userId": { ".validate": "newData.val() === auth.uid || !newData.exists()" }
      }
    },

    "addFunds": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('userId').val() === auth.uid",
        "userId": { ".validate": "newData.val() === auth.uid" },
        "amount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "coins":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "ts":     { ".validate": "newData.isNumber()" }
      }
    },

    "deposits": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('userId').val() === auth.uid",
        "userId": { ".validate": "newData.val() === auth.uid" }
      }
    },

    "cashouts": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('userId').val() === auth.uid",
        "userId": { ".validate": "newData.val() === auth.uid" }
      }
    },

    "dollarRequests": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('userId').val() === auth.uid",
        "userId": { ".validate": "newData.val() === auth.uid" }
      }
    },

    "transactions": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && !data.exists()",
        "userId": { ".validate": "newData.val() === auth.uid" },
        "amount": { ".validate": "newData.isNumber()" },
        "ts":     { ".validate": "newData.isNumber()" }
      }
    },

    "admin": { ".read": false, ".write": false }
  }
}

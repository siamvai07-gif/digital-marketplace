{
  "rules": {
    ".read": false,
    ".write": false,

    "products": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true",
      "$productId": {
        ".validate": "newData.hasChildren(['name','price'])"
      }
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && auth.token.admin === true"
    },

    "reviews": {
      ".read": true,
      "$reviewId": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || auth.token.admin === true)",
        "rating": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
        "text": { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "uid": { ".validate": "newData.val() === auth.uid" },
        "ts": { ".validate": "newData.isNumber()" }
      }
    },

    "lookup": {
      "email": {
        "$ident": {
          ".read": true,
          ".write": "auth != null && ((!data.exists() && auth.uid != null) || auth.token.admin === true)"
        }
      },
      "phone": {
        "$ident": {
          ".read": true,
          ".write": "auth != null && ((!data.exists() && auth.uid != null) || auth.token.admin === true)"
        }
      }
    },

    "customers": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && ((!data.exists() && auth.uid === $uid) || auth.token.admin === true)",
        "walletCoins": {
          ".write": "auth != null && auth.token.admin === true",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "status": {
          ".validate": "newData.val() === 'ACTIVE' || newData.val() === 'SUSPENDED'"
        },
        "passwordHash": { ".validate": "newData.isString()" },
        "isAdmin": { ".write": "auth.token.admin === true" }
      }
    },

    "orders": {
      ".read": "auth != null && auth.token.admin === true",
      "$id": {
        ".write": "auth != null && (!data.exists() && newData.child('userId').val() === auth.uid) || auth.token.admin === true",
        "userId": { ".validate": "newData.val() === auth.uid" },
        "amount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "ts": { ".validate": "newData.isNumber()" }
      }
    },

    "addFunds": {
      ".read": "auth != null && auth.token.admin === true",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || auth.token.admin === true)",
        "userId": { ".validate": "newData.val() === auth.uid" },
        "amount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "coins": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "status": { ".validate": "newData.val() === 'PENDING' || newData.val() === 'COMPLETED' || newData.val() === 'REJECTED'" },
        "ts": { ".validate": "newData.isNumber()" }
      }
    },

    "deposits": {
      ".read": "auth != null && auth.token.admin === true",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || auth.token.admin === true)",
        "userId": { ".validate": "newData.val() === auth.uid" }
      }
    },

    "cashouts": {
      ".read": "auth != null && auth.token.admin === true",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || auth.token.admin === true)",
        "userId": { ".validate": "newData.val() === auth.uid" }
      }
    },

    "dollarRequests": {
      ".read": "auth != null && auth.token.admin === true",
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || auth.token.admin === true)",
        "userId": { ".validate": "newData.val() === auth.uid" }
      }
    },

    "transactions": {
      ".read": "auth != null && auth.token.admin === true",
      "$id": {
        ".write": "auth != null && auth.token.admin === true",
        "userId": { ".validate": "newData.isString()" },
        "amount": { ".validate": "newData.isNumber()" },
        "ts": { ".validate": "newData.isNumber()" }
      }
    },

    "admin": { ".read": false, ".write": false }
  }
}
